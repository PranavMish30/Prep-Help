# 📦 Dependency Directories
# Node.js modules for both client and server
client/node_modules/
server/node_modules/

# ⚙️ Build and Output Directories
# Generated build files for the React client
client/build/
client/dist/

# Temporary or local configuration files
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 🔒 Package Lock Files
# You may want to commit 'package-lock.json' or 'yarn.lock' for deterministic installs,
# but if you prefer to ignore them (e.g., in smaller/personal projects):
package-lock.json
yarn.lock

# 💻 Editor and OS Specific Files
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IntelliJ / WebStorm
.idea/

# macOS / Windows
